{
  "name": "pondering-orb-desktop",
  "productName": "Pondering Orb",
  "private": true,
  "version": "0.1.0",
  "description": "Pondering Orb on your computer: the dashboard in its own window, the tray, notifications and shortcuts.",
  "license": "MIT",
  "homepage": "https://github.com/Wizard815/pondering-orb",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wizard815/pondering-orb.git",
    "directory": "desktop"
  },
  "author": {
    "name": "Pondering Orb",
    "email": "noreply@users.noreply.github.com"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "npm run build && node --import tsx --test e2e/*.test.ts",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@types/node": "22.20.5",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.ponderingorb.desktop",
    "productName": "Pondering Orb",
    "executableName": "pondering-orb",
    "copyright": "Pondering Orb",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "build/tray-alert.png",
      "build/tray-alert@2x.png",
      "package.json"
    ],
    "artifactName": "Pondering-Orb-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Pondering Orb",
      "synopsis": "Your homelab dashboard",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libsecret-1-0",
        "libappindicator3-1"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pondering Orb"
    }
  },
  "desktopName": "pondering-orb.desktop"
}
