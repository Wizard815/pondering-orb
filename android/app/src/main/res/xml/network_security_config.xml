<?xml version="1.0" encoding="utf-8"?>
<!-- Orb on the home network is often plain http (http://192.168.x.x:8095). From outside the
     house, use the Cloudflare tunnel's https address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
