# Pondering Orb: copy to .env next to docker-compose.yml and fill in.
# Never commit .env (it is in .gitignore). Values here never reach the browser.

# Your time zone, as an IANA name (Europe/London, America/Chicago,
# Australia/Sydney ...). It decides what "today" is for logs, chores, the
# daily digest and the wiki log file, for every container in the stack.
TZ=UTC

# Sign-in for the web app (required).
ORB_PASSWORD=

# Agent tokens for the API and /mcp: "name:token" pairs, comma separated.
# The name is recorded on everything that agent writes.
ORB_API_TOKENS=

# Addresses of apps on other computers (leave empty if you don't run them).
UPSTREAM_URL=
ALLGLANCE_URL=

# Logins and keys. Settings and orb.yaml name these variables; they never
# hold the values themselves.
CALDAV_USER=
CALDAV_PASSWORD=
WIKI_API_KEY=
HERMES_USER=
HERMES_PASSWORD=
ALLGLANCE_TOKEN=
OPENROUTER_API_KEY=
PLEX_TOKEN=
SABNZBD_API_KEY=

# Optional: a free Tiingo key (tiingo.com) for stock prices. Without it Orb
# tries Yahoo's chart API, then Stooq, which can refuse or rate-limit.
TIINGO_API_KEY=

# Optional: a key for your self-hosted decision model, if it wants one. Name
# this variable in Settings -> Stock picks -> Decision model.
DECIDER_KEY=

# Read-only keys for your own apps, named by key_env in the apps YAML:
# Goblin-Bank's Orb key (CoinGateway, scope summary:read) and an omi_dev_
# key from omi-local. See docs/companions.md.
GOBLIN_ORB_KEY=
OMI_DEV_KEY=

# Optional sign-in for the btop terminal ("user:password").
BTOP_AUTH=
