# Pondering Orb: copy to .env next to docker-compose.yml and fill in.
# Never commit .env (it is in .gitignore). Values here never reach the browser.

# Your time zone, as an IANA name (Europe/London, America/Chicago,
# Australia/Sydney ...). It decides what "today" is for logs, chores, the
# daily digest and the wiki log file, for every container in the stack.
TZ=UTC

# Sign-in for the web app (required).
ORB_PASSWORD=

# Agent tokens for the API and /mcp: "name:token" pairs, comma separated.
# The name is recorded on everything that agent writes.
ORB_API_TOKENS=

# Optional: the port Orb listens on (on the host) and the name the System
# tab shows for this machine.
ORB_PORT=8095
ORB_HOSTNAME=

# Addresses of apps you run (empty = not used). A container name works when
# Orb shares their Docker network; otherwise http://<host>:<port>.
ALLGLANCE_URL=
MILACLONE_URL=          # Milaclone (Ideas tab), as your browser reaches it, e.g. http://tower:4321
MILACLONE_API_URL=      # optional: how the Orb server reaches Milaclone, if not the same address (Golem reads its boards)
MILACLONE_API_KEY=      # optional: Milaclone's API_KEY, if you set one
UNRAID_URL=             # Unraid Management Agent, e.g. http://192.168.20.5:8043 (Links page)
UNRAID_LINK_HOST=       # the server's LAN address for app links, e.g. 192.168.20.5 (empty: found from the agent)
NPM_URL=                # Nginx Proxy Manager's admin address, e.g. http://192.168.20.5:81 (app links use its names)
NGINX_CONF_DIR=         # or: nginx/SWAG config folder mounted read only (see the compose file), e.g. /nginx
NGINX_DOMAIN=           # your domain, for SWAG's "app.*" names, e.g. thefellashub.com
TECHNITIUM_URL=         # Technitium DNS, e.g. http://192.168.20.5:5380 (app links can use its names)
UPSTREAM_URL=
UPTIME_URL=
UPTIME_KUMA_USER=        # an Uptime Kuma admin login, only for Settings → Scripts (adds monitors for proxied sites and Orb's apps)
UPTIME_KUMA_PASSWORD=
UPTIME_PORT=             # host port for the bundled Uptime Kuma (default 3001)
HERMES_URL=
HERMES_PUBLIC_URL=
ARGOS_URL=
# A family LLMWIKI: http://<host>:27123/family, with your own token as WIKI_API_KEY.
WIKI_URL=

# The LLMWIKI vault folder on this host, mounted read only for the Wiki tab.
# Leave empty for a family vault (it would show everyone's notes).
LLMWIKI_VAULT=

# Logins and keys. Settings and orb.yaml name these variables; they never
# hold the values themselves.
CALDAV_USER=
CALDAV_PASSWORD=
WIKI_API_KEY=
HERMES_USER=
HERMES_PASSWORD=
UNRAID_TOKEN=           # the Unraid Management Agent's API token
NPM_EMAIL=              # an Nginx Proxy Manager login (a user that can view proxy hosts is enough)
NPM_PASSWORD=
TECHNITIUM_TOKEN=       # a Technitium DNS API token (Administration -> Sessions -> Create Token)
ALLGLANCE_TOKEN=
OPENROUTER_API_KEY=
PLEX_TOKEN=
SABNZBD_API_KEY=

# Optional: a free Tiingo key (tiingo.com) for stock prices. Without it Orb
# tries Yahoo's chart API, then Stooq, which can refuse or rate-limit.
TIINGO_API_KEY=

# Optional: a key for your self-hosted decision model, if it wants one. Name
# this variable in Settings -> Stock picks -> Decision model.
DECIDER_KEY=

# Read-only keys for your own apps, named by key_env in the apps YAML:
# a Firefly III Personal Access Token and an omi_dev_ key from omi-local.
# See docs/companions.md.
FIREFLY_TOKEN=          # Firefly III: Options -> Profile -> OAuth -> Personal access tokens
COINPILE_TOKEN=         # Coinpile: Settings -> Home Assistant & API, a token with the "orb" scope
OMI_DEV_KEY=

# Optional sign-in for the btop terminal ("user:password").
BTOP_AUTH=
